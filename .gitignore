node_modules/
dist-renderer/
release/
dist/
# build/ holds generated packaging files, but the app icons must be committed:
# without them a clean checkout (CI) packages with Electron's default icon.
build/*
!build/icon.ico
!build/icon.png

.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

# Manual QA scratch domes/logs -- never commit these going forward.
# (A number of pre-existing tmp-* directories are already tracked from
# before this rule; useful ones have been deliberately copied into
# test/fixtures/ instead of being purged from history.)
tmp-*/
tmp-dev-logs/
